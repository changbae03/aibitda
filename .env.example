# ─────────────────────────────────────────────────────────────────────────────
# 애빛다 환경변수 템플릿
#
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# 값 출처: Replit 프로젝트 → 좌측 Tools → Secrets (자물쇠 아이콘)
# .env는 .gitignore에 등록돼 있어 커밋되지 않는다. 이 파일(.env.example)에는
# 절대 실제 값을 적지 말 것 — 여기는 커밋된다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────────────────────
# 없으면 서버가 아예 뜨지 않는다.

# PostgreSQL 접속 주소 (Neon). NEON_DATABASE_URL로 넣어도 동작한다.
DATABASE_URL=

# API 서버가 사용할 포트. 로컬에서는 8080을 쓴다
# (웹 프론트의 vite dev 서버가 /api 요청을 localhost:8080으로 넘기도록 설정돼 있음).
PORT=8080

NODE_ENV=development


# ── AI 분석 (핵심 기능) ───────────────────────────────────────────────────────
# 이게 없으면 종목 분석이 동작하지 않는다.
# GEMINI_API_KEY를 직접 넣으면 Replit AI 중계를 거치지 않는다 — 로컬에서는 이쪽을 쓴다.
GEMINI_API_KEY=

# Replit AI Integrations 경유 시에만 사용. 로컬 개발에서는 비워둔다.
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=


# ── 로그인·인증 ───────────────────────────────────────────────────────────────
# 미설정 시 개발용 임시값으로 대체되지만(로그인 세션이 안전하지 않음),
# NODE_ENV=production이면 JWT_SECRET 없이는 서버가 기동을 거부한다.
JWT_SECRET=
CLERK_SECRET_KEY=

# 카카오 로그인. 로컬에서 카카오 로그인을 테스트하려면 카카오 개발자 콘솔에
# 아래 콜백 주소를 등록해야 한다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# 로그인 후 돌아올 프론트엔드 주소 (로컬 vite dev 서버)
FRONTEND_URL=http://localhost:22315


# ── 시장 데이터 소스 (선택) ───────────────────────────────────────────────────
# 없어도 서버는 뜬다. 해당 데이터만 빠진 채로 분석이 진행된다.
# 분석 정확도에 직접 영향을 주므로 가능한 채우는 것이 좋다.

# 한국투자증권 — 한국 주식 실시간 시세·PER·PBR
KIS_APP_KEY=
KIS_APP_SECRET=

# DART — 전자공시 재무제표
DART_API_KEY=

# 한국거래소
KRX_API_KEY=
KRX_ID=
KRX_PW=

# 한국은행 경제통계 / 미국 연준 / 국가통계포털 — 거시지표
ECOS_API_KEY=
FRED_API_KEY=
KOSIS_API_KEY=

# Financial Modeling Prep — 해외 종목 재무
FMP_API_KEY=


# ── 알림 (선택) ───────────────────────────────────────────────────────────────
# 비워두면 알림만 나가지 않는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── 모바일 앱 (iOS·Android) ───────────────────────────────────────────────────
# 시뮬레이터·실기기에는 "현재 주소"라는 개념이 없어서 API 주소를 명시해야 한다.
#   iOS 시뮬레이터   : http://localhost:8080
#   안드로이드 에뮬레이터: http://10.0.2.2:8080
#   실제 휴대폰(같은 와이파이): http://<맥의 LAN IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
CLERK_PUBLISHABLE_KEY=


# ── 로컬 환경 조정 (선택) ─────────────────────────────────────────────────────
# pykrx(Python)를 실행할 인터프리터 경로. 비워두면 자동 탐색한다.
# 한국 수급·공매도·급등주·ETF·테마 데이터가 이 경로를 통해 수집된다.
PYTHON_BIN=

# 시장 분석 서버를 별도 프로세스로 띄울 때 쓰는 내부 포트.
MARKET_INTERNAL_PORT=
